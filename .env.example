# -----------------------------------------------------------------------------
# .env.example — committed template documenting expected env vars.
# Real values live in `.env.local` (gitignored via the `.env.*` rule in
# .gitignore; verify with `git check-ignore .env.local` exit 0).
# -----------------------------------------------------------------------------

# Phase 7 (FN-07) — App Check + reCAPTCHA Enterprise
# ---------------------------------------------------------------------------
# Production site key issued by Firebase Console App Check enrolment.
# PER-ENV: do NOT share keys across dev / staging / prod.
# Domain-bound public identifier (NOT a secret — accept disposition
# T-07-03-02). The operational discipline of one-key-per-env exists for
# clean revocation, not for confidentiality.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=6L_REPLACE_ME

# Debug token for local Vite dev server / CI / scratch-project bypasses.
# Generate via Firebase Console -> App Check -> Apps -> ⋮ -> "Manage debug
# tokens" -> "Add debug token". One token per developer / CI runner — do NOT
# share. NEVER commit a real token (Pitfall 8 mitigation; T-07-03-04 mitigate).
# Vite tree-shakes the DEV branch from production bundles, so this var is
# only read in `import.meta.env.DEV` mode.
VITE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000

# Local-dev emulator suite (Phase 06.1 UAT support)
# ---------------------------------------------------------------------------
# Set to "1" in .env.local to route Auth / Firestore / Storage / Functions
# at the local Firebase emulator suite (ports 9099 / 8080 / 9199 / 5001).
# Required for end-to-end UAT of callables (inviteClient, setClaims, etc.)
# from `npm run dev` — production endpoints reject cross-origin preflight
# from localhost by design (same-origin invariant via Firebase Hosting).
# Gated on `import.meta.env.DEV` so it tree-shakes out of production bundles.
# Companion: run `firebase emulators:start` in a second terminal.
VITE_USE_EMULATORS=0

# Local tooling only — GitHub API (NOT read by the app)
# ---------------------------------------------------------------------------
# Personal access token used from the dev machine to read CI state (failing
# job logs, check runs) and to open / update pull requests. Deliberately has
# NO `VITE_` prefix: Vite only exposes VITE_-prefixed vars to client code, so
# this can never reach a browser bundle. Never commit a real value — put it in
# `.env.local` (gitignored via the `.env.*` rule; verify with
# `git check-ignore .env.local` exit 0).
#
# Must be a CLASSIC PAT with the `repo` scope, not a fine-grained one: this
# repo is owned by the `lukebadiali` account and we are collaborators on it,
# and fine-grained tokens can only be scoped to repos owned by the issuing
# account. Generate at https://github.com/settings/tokens ("Generate new
# token (classic)"), short expiry, and revoke there once the task is done.
# Note the repo being public is not sufficient — the Actions logs API returns
# 403 unauthenticated even though the same logs render in the web UI.
GH_TOKEN=
